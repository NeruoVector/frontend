# 비워두면 현재 오리진의 /api 를 사용합니다. (Vite dev proxy / nginx proxy)
VITE_API_BASE_URL=

# Vite 개발 서버와 preview의 /api 프록시 (브라우저에 노출되지 않음)
# 우선순위: NV_BACKEND > DEV_API_PROXY_TARGET > https://neurovector-backend.forge-lang.org
# 로컬 백엔드 예: NV_BACKEND=http://127.0.0.1:8081
NV_BACKEND=

# 기존 설정 호환용. NV_BACKEND가 비어 있을 때만 사용합니다.
DEV_API_PROXY_TARGET=
